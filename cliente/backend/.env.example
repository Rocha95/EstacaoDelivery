PORT=3334
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sistema_delivery
JWT_SECRET=troque-por-um-segredo-forte
CORS_ORIGIN=http://localhost:5174
# Pasta das imagens cadastradas pelo Painel. No monorepo, o padrão já aponta para painel/backend/uploads.
# UPLOADS_DIR=C:/caminho/EstacaoDelivery/painel/backend/uploads
# URL pública do backend do Painel, onde ficam /uploads/produtos/*
PAINEL_PUBLIC_URL=http://localhost:3333
# User-Agent identificando sua aplicação para o serviço de geocodificação
GEOCODING_USER_AGENT=EstacaoDelivery/1.0 contato@seudominio.com
# Opcional: servidor compatível com a API do Nominatim
# GEOCODING_URL=https://nominatim.openstreetmap.org/search

# Serviço de rotas rodoviárias (OSRM por padrão).
ROUTING_URL=https://router.project-osrm.org
ROUTING_USER_AGENT=EstacaoDelivery/1.0 contato@seudominio.com
# Se false, falha em vez de usar Haversine como fallback.
ROUTING_FALLBACK_HAVERSINE=false
# Regeocodifica o endereço do cliente ao recalcular a entrega. Útil para evitar coordenadas antigas.
REVALIDAR_COORDENADAS_ENDERECO=true
