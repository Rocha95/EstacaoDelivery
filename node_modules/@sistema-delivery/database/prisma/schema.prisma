// Schema unificado do sistema de pedidos e delivery.
// Um banco só, consumido pelos dois apps (painel e cliente).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Usuários (cliente ou equipe do estabelecimento)
// ---------------------------------------------------------------------------

enum TipoUsuario {
  CLIENTE
  EQUIPE
}

enum PapelEquipe {
  ADMINISTRADOR
  GERENTE
  COZINHA
  ATENDIMENTO
}

model Estabelecimento {
  id        String   @id @default(uuid())
  slug      String   @unique
  nome      String
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now())

  configuracao Configuracao?
  categorias Categoria[]
  produtos Produto[]
  gruposAdicionais GrupoAdicional[]
  adicionais OpcaoAdicional[]
  combos Combo[]
  horarios HorarioFuncionamento[]
  cupons Cupom[]
  faixasEntrega FaixaTaxaEntrega[]
  pedidos Pedido[]
  equipe Usuario[]
  fidelidades Fidelidade[]

  @@map("estabelecimentos")
}

model Usuario {
  id        String       @id @default(uuid())
  nome      String
  email     String?      @unique
  telefone  String?      @unique
  senhaHash String
  tipo      TipoUsuario
  papel     PapelEquipe? // só preenchido quando tipo = EQUIPE
  ativo     Boolean      @default(true)
  podeCriarUsuarios Boolean @default(false)
  criadoEm  DateTime     @default(now())
  estabelecimentoId String?
  estabelecimento Estabelecimento? @relation(fields: [estabelecimentoId], references: [id])

  enderecos Endereco[]
  pedidos   Pedido[]
  fidelidades Fidelidade[]
  avaliacoes Avaliacao[]
  sessoes    SessaoUsuario[]

  @@map("usuarios")
}

model SessaoUsuario {
  id             String   @id @default(uuid())
  tokenHash      String   @unique
  usuarioId      String
  usuario        Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expiraEm       DateTime
  criadoEm       DateTime @default(now())
  ultimoAcessoEm DateTime @updatedAt

  @@index([usuarioId])
  @@index([expiraEm])
  @@map("sessoes_usuarios")
}

model Endereco {
  id          String  @id @default(uuid())
  usuario     Usuario @relation(fields: [usuarioId], references: [id])
  usuarioId   String
  apelido     String?
  rua         String
  numero      String?
  complemento String?
  bairro      String
  cidade      String
  estado      String
  cep         String?
  latitude    Float?
  longitude   Float?
  distanciaKm Float? // calculado automaticamente a partir das coordenadas do estabelecimento e do endereço

  pedidos  Pedido[]
  criadoEm DateTime @default(now())

  @@map("enderecos")
}

// ---------------------------------------------------------------------------
// Cardápio: categorias, produtos, adicionais, combos
// ---------------------------------------------------------------------------

model Categoria {
  id    String  @id @default(uuid())
  estabelecimentoId String @default("default")
  estabelecimento Estabelecimento @relation(fields: [estabelecimentoId], references: [id])
  nome  String
  ordem Int     @default(0)
  ativa Boolean @default(true)

  produtos  Produto[]
  adicionais OpcaoAdicional[]

  @@map("categorias")
}
model Produto {
  id                    String   @id @default(uuid())
  estabelecimentoId String @default("default")
  estabelecimento Estabelecimento @relation(fields: [estabelecimentoId], references: [id])
  nome                  String
  descricao             String?
  preco                 Decimal  @db.Decimal(10, 2)
  emoji                 String?
  imagemUrl             String?
  ativo                 Boolean  @default(true)
  controlaEstoque       Boolean  @default(false)
  estoqueAtual          Int      @default(0)
  estoqueMinimo         Int      @default(0)
  // Janela própria de disponibilidade (ex: só no almoço). Nula = segue o
  // horário geral de funcionamento (HorarioFuncionamento).
  disponibilidadeInicio String? // formato "HH:MM"
  disponibilidadeFim    String?

  categoria   Categoria @relation(fields: [categoriaId], references: [id])
  categoriaId String

  gruposAdicionais ProdutoGrupoAdicional[]
  itensPedido      ItemPedido[]
  movimentosEstoque EstoqueMovimento[]
  combosItens      ComboItem[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("produtos")
}

// Um grupo de adicionais (ex: "Adicionais de lanche", com limite de seleção)
// pode ser reaproveitado por vários produtos — por isso a tabela de junção.
model GrupoAdicional {
  id            String  @id @default(uuid())
  estabelecimentoId String @default("default")
  estabelecimento Estabelecimento @relation(fields: [estabelecimentoId], references: [id])
  nome          String
  maximoSelecao Int     @default(1)
  obrigatorio   Boolean @default(false)

  opcoes   OpcaoAdicional[]
  produtos ProdutoGrupoAdicional[]

  @@map("grupos_adicionais")
}
model OpcaoAdicional {
  id        String  @id @default(uuid())
  estabelecimentoId String @default("default")
  estabelecimento Estabelecimento @relation(fields: [estabelecimentoId], references: [id])
  nome      String
  preco     Decimal @db.Decimal(10, 2) @default(0)
  ativo     Boolean @default(true)
  imagemUrl String?

  grupo   GrupoAdicional? @relation(fields: [grupoId], references: [id])
  grupoId String?

  // Regra atual do cardápio: o adicional pertence à mesma categoria dos produtos
  // nos quais deve aparecer. O grupo antigo permanece opcional apenas para
  // compatibilidade com dados legados.
  categoria   Categoria? @relation(fields: [categoriaId], references: [id])
  categoriaId String?

  itensSelecionados ItemPedidoAdicional[]

  @@map("opcoes_adicionais")
}
model ProdutoGrupoAdicional {
  produto   Produto        @relation(fields: [produtoId], references: [id])
  produtoId String
  grupo     GrupoAdicional @relation(fields: [grupoId], references: [id])
  grupoId   String

  @@id([produtoId, grupoId])
  @@map("produto_grupo_adicional")
}

model Combo {
  id        String  @id @default(uuid())
  estabelecimentoId String @default("default")
  estabelecimento Estabelecimento @relation(fields: [estabelecimentoId], references: [id])
  nome      String
  preco     Decimal @db.Decimal(10, 2)
  imagemUrl String?
  ativo Boolean @default(true)

  itens       ComboItem[]
  itensPedido ItemPedido[]

  @@map("combos")
}
model ComboItem {
  combo      Combo   @relation(fields: [comboId], references: [id])
  comboId    String
  produto    Produto @relation(fields: [produtoId], references: [id])
  produtoId  String
  quantidade Int     @default(1)

  @@id([comboId, produtoId])
  @@map("combo_itens")
}

// ---------------------------------------------------------------------------
// Operação: horários, cupons, taxas de entrega, configuração geral
// ---------------------------------------------------------------------------

model HorarioFuncionamento {
  id        String  @id @default(uuid())
  estabelecimentoId String @default("default")
  estabelecimento Estabelecimento @relation(fields: [estabelecimentoId], references: [id])
  diaSemana Int // 0 = domingo ... 6 = sábado
  ativo     Boolean @default(true)
  abre      String // "HH:MM"
  fecha     String // "HH:MM"

  @@unique([estabelecimentoId, diaSemana])
  @@map("horarios_funcionamento")
}

enum TipoCupom {
  PERCENTUAL
  VALOR_FIXO
  FRETE_GRATIS
}
model Cupom {
  id           String    @id @default(uuid())
  estabelecimentoId String @default("default")
  estabelecimento Estabelecimento @relation(fields: [estabelecimentoId], references: [id])
  codigo       String
  tipo         TipoCupom
  valor        Decimal   @db.Decimal(10, 2) @default(0) // ignorado se FRETE_GRATIS
  pedidoMinimo Decimal   @db.Decimal(10, 2) @default(0)
  validoAte    DateTime?
  ativo        Boolean   @default(true)
  criadoEm     DateTime  @default(now())

  pedidos Pedido[]

  @@unique([estabelecimentoId, codigo])
  @@map("cupons")
}

// Faixas de distância → valor da taxa de entrega, calculadas a partir do
// endereço do estabelecimento (Configuracao.endereco / latitude / longitude).
model FaixaTaxaEntrega {
  id    String  @id @default(uuid())
  estabelecimentoId String @default("default")
  estabelecimento Estabelecimento @relation(fields: [estabelecimentoId], references: [id])
  ateKm Float // limite superior da faixa; a última faixa cobre "acima de"
  valor Decimal @db.Decimal(10, 2)
  ordem Int     @default(0)

  @@map("faixas_taxa_entrega")
}
model Configuracao {
  id                   String  @id @default("default")
  estabelecimentoId String @unique @default("default")
  estabelecimento Estabelecimento @relation(fields: [estabelecimentoId], references: [id])
  nomeEstabelecimento  String
  telefone             String?
  endereco             String
  enderecoRua          String?
  enderecoNumero       String?
  enderecoBairro       String?
  enderecoCidade       String?
  enderecoEstado       String?
  enderecoCep          String?
  latitude             Float?
  longitude            Float?
  pedidoMinimo         Decimal @db.Decimal(10, 2) @default(0)
  tempoPreparoMedioMin Int     @default(30)
  raioMaximoEntregaKm  Float   @default(12)
  aceitaDelivery       Boolean @default(true)
  aceitaRetirada       Boolean @default(true)
  pontosPorReal        Float   @default(1)
  whatsappAtivo        Boolean @default(false)
  chavePix             String?

  @@map("configuracoes")
}

// ---------------------------------------------------------------------------
// Pagamentos, estoque, fidelidade e avaliações
// ---------------------------------------------------------------------------

enum StatusPagamento {
  PENDENTE
  APROVADO
  REJEITADO
  CANCELADO
  EXPIRADO
}

enum TipoMovimentoEstoque {
  ENTRADA
  SAIDA
  AJUSTE
  VENDA
  ESTORNO
}

enum TipoMovimentoFidelidade {
  CREDITO
  DEBITO
  AJUSTE
}
model Pagamento {
  id             String           @id @default(uuid())
  pedido         Pedido           @relation(fields: [pedidoId], references: [id])
  pedidoId       String           @unique
  provedor       String
  externoId      String?
  status         StatusPagamento  @default(PENDENTE)
  valor          Decimal          @db.Decimal(10, 2)
  qrCode         String?
  qrCodeBase64   String?
  copiaECola     String?
  ticketUrl      String?
  expiraEm       DateTime?
  criadoEm       DateTime         @default(now())
  atualizadoEm   DateTime         @updatedAt

  @@map("pagamentos")
}

model EstoqueMovimento {
  id              String               @id @default(uuid())
  produto         Produto              @relation(fields: [produtoId], references: [id])
  produtoId       String
  tipo            TipoMovimentoEstoque
  quantidade      Int
  saldoAnterior   Int
  saldoPosterior  Int
  motivo          String?
  pedido          Pedido?              @relation(fields: [pedidoId], references: [id])
  pedidoId        String?
  criadoEm        DateTime             @default(now())

  @@index([produtoId, criadoEm])
  @@map("estoque_movimentos")
}

model Fidelidade {
  id                String   @id @default(uuid())
  estabelecimentoId String
  estabelecimento   Estabelecimento @relation(fields: [estabelecimentoId], references: [id])
  usuario           Usuario @relation(fields: [usuarioId], references: [id])
  usuarioId         String
  pontosSaldo       Int      @default(0)
  pontosAcumulados  Int      @default(0)
  criadoEm          DateTime @default(now())
  atualizadoEm      DateTime @updatedAt

  movimentos MovimentoFidelidade[]

  @@unique([usuarioId, estabelecimentoId])
  @@map("fidelidades")
}

model MovimentoFidelidade {
  id           String                    @id @default(uuid())
  fidelidade   Fidelidade                @relation(fields: [fidelidadeId], references: [id])
  fidelidadeId String
  tipo         TipoMovimentoFidelidade
  pontos       Int
  descricao    String
  pedido       Pedido?                   @relation(fields: [pedidoId], references: [id])
  pedidoId     String?
  criadoEm     DateTime                  @default(now())

  @@index([fidelidadeId, criadoEm])
  @@map("movimentos_fidelidade")
}

model Avaliacao {
  id          String   @id @default(uuid())
  pedido      Pedido   @relation(fields: [pedidoId], references: [id])
  pedidoId    String   @unique
  cliente     Usuario  @relation(fields: [clienteId], references: [id])
  clienteId   String
  nota        Int
  comentario  String?
  resposta    String?
  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([clienteId, criadoEm])
  @@map("avaliacoes")
}

// ---------------------------------------------------------------------------
// Pedidos
// ---------------------------------------------------------------------------

enum TipoEntrega {
  DELIVERY
  RETIRADA
}

enum FormaPagamento {
  PIX
  DINHEIRO_ENTREGA
  CARTAO_ENTREGA
}

enum StatusPedido {
  AGUARDANDO_PAGAMENTO
  RECEBIDO
  EM_PRODUCAO
  SAIU_PARA_ENTREGA
  FINALIZADO
  CANCELADO
}

model Pedido {
  id             String         @id @default(uuid())
  estabelecimentoId String @default("default")
  estabelecimento Estabelecimento @relation(fields: [estabelecimentoId], references: [id])
  numero         Int            @unique @default(autoincrement())
  cliente        Usuario        @relation(fields: [clienteId], references: [id])
  clienteId      String
  tipoEntrega    TipoEntrega
  endereco       Endereco?      @relation(fields: [enderecoId], references: [id])
  enderecoId     String?
  formaPagamento FormaPagamento
  status         StatusPedido   @default(RECEBIDO)
  pagamentoStatus StatusPagamento @default(PENDENTE)
  pagamento      Pagamento?

  subtotal    Decimal @db.Decimal(10, 2)
  taxaEntrega Decimal @db.Decimal(10, 2) @default(0)
  desconto    Decimal @db.Decimal(10, 2) @default(0)
  total       Decimal @db.Decimal(10, 2)

  cupom       Cupom?  @relation(fields: [cupomId], references: [id])
  cupomId     String?
  observacoes String?
  agendadoPara DateTime?

  itens ItemPedido[]
  movimentosEstoque EstoqueMovimento[]
  movimentosFidelidade MovimentoFidelidade[]
  avaliacao Avaliacao?

  criadoEm      DateTime  @default(now())
  producaoEm    DateTime?
  saiuEntregaEm DateTime?
  finalizadoEm  DateTime?

  @@map("pedidos")
}

// Um item pode vir de um produto avulso OU de um combo — nunca os dois.
model ItemPedido {
  id            String  @id @default(uuid())
  pedido        Pedido  @relation(fields: [pedidoId], references: [id])
  pedidoId      String
  produto       Produto? @relation(fields: [produtoId], references: [id])
  produtoId     String?
  combo         Combo?   @relation(fields: [comboId], references: [id])
  comboId       String?
  // snapshot: preserva nome/preço mesmo se o produto mudar depois
  nome          String
  precoUnitario Decimal @db.Decimal(10, 2)
  quantidade    Int     @default(1)

  adicionais ItemPedidoAdicional[]

  @@map("itens_pedido")
}

model ItemPedidoAdicional {
  id       String         @id @default(uuid())
  item     ItemPedido     @relation(fields: [itemId], references: [id])
  itemId   String
  opcao    OpcaoAdicional @relation(fields: [opcaoId], references: [id])
  opcaoId  String
  nome     String // snapshot
  preco    Decimal        @db.Decimal(10, 2)

  @@map("itens_pedido_adicionais")
}
