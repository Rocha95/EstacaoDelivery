PORT=3334
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sistema_delivery
JWT_SECRET=troque-por-um-segredo-forte
CORS_ORIGIN=http://localhost:5174
ESTABELECIMENTO_ID=default

# Rotas / geocodificação
ROUTING_URL=https://router.project-osrm.org
ROUTING_FALLBACK_HAVERSINE=false
REVALIDAR_COORDENADAS_ENDERECO=true
REVALIDAR_COORDENADAS_ESTABELECIMENTO=true
ALLOW_STALE_ESTABLISHMENT_COORDS=false

# Pagamento online Pix (Mercado Pago)
